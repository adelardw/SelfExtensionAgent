        <mxCell id="capability_research" value="capability_research&#10;разведка способностей; на пробеле — найти и&#10;подключить MCP (реестр + доверенный каталог, HITL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="2980" width="380" height="140" as="geometry" />
