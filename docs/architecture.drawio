          <mxGeometry x="290" y="3270" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="skill_injection" value="skill_injection&#10;инъекция выбранных навыков / тулов&#10;в набор инструментов исполнителя шагов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
