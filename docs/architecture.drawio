<mxfile host="app.diagrams.net" agent="self-extension-agent">
  <diagram name="self-extension-agent" id="selfext-arch">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="self-extension-agent — архитектура · LangGraph-граф = обучаемая программа · тонкий клиент + Python-мозг" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>

        <!-- ===== INTERFACES BAND ===== -->
        <mxCell id="clients" value="Интерфейсы — тонкие клиенты (один Python-мозг под всеми)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1000" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_gui" value="Web GUI&#10;React + Vite + Tailwind&#10;Atlassian-токены, Inter&#10;desktop.py (нативный webview)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="112" width="230" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c_repl" value="REPL&#10;main.py (rich, история)&#10;one-shot режим" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="112" width="220" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c_tg" value="Telegram&#10;bot.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="550" y="112" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c_ext" value="Chrome-расширение&#10;агент в ТВОЁМ браузере&#10;(твои логины/вкладки, WS-мост)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="770" y="112" width="250" height="64" as="geometry" />
        </mxCell>

        <!-- ===== SERVER / BRAIN ===== -->
        <mxCell id="server" value="FastAPI-сервер · server.py&#10;фоновый прогон (astream) · /chat → run_id · /run/{id} (poll живого прогресса по узлам) · /run/{id}/respond&#10;ИНТЕРАКТИВНЫЙ clarify (Q/A-мультиселект) + confirm (HITL) через contextvar · /settings · /upload · /transcribe&#10;AsyncSqliteSaver-чекпоинты · режим auto-accept (ты локальный оператор)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1000" height="86" as="geometry" />
        </mxCell>

        <!-- ===== LANGGRAPH FORWARD GRAPH BOX ===== -->
        <mxCell id="graphbox" value="LangGraph forward-граф (один запрос) · backward = credit-assignment по трейсу (самообучение)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;fontStyle=1;dashed=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="1030" height="1230" as="geometry" />
        </mxCell>

        <mxCell id="n_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="372" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_recall" value="recall — память + AutoRAG&#10;• ГИБКИЙ recall: факты И эпизоды по РЕЛЕВАНТНОСТИ (не «персона всегда»)&#10;• гейт fg = max(0.18, gate·0.85) + graph-boost — чинит лик контекста между задачами&#10;• GraphRAG-lite по рёбрам · запрос эмбеддится 1 раз · впрыск БЗ/own_docs · анти-PII санитизация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="430" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n_goal" value="goal — цель + rubric&#10;формализует критерий успеха и держит его в контексте до конца прогона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="558" width="430" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_refl" value="reflexion — ВЫБОР типа мышления (роутер)&#10;LLM-классификатор + бандит-прайор + few-shots (без keyword-костылей)&#10;высокая неоднозначность → clarify_gate · цена/риск задачи → тир модели" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="430" height="78" as="geometry" />
        </mxCell>

        <!-- branches -->
        <mxCell id="n_fast" value="fast / reason&#10;System 1 / System 2&#10;прямой ответ без тулов&#10;(короткий ответ vs рассуждение)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="250" height="86" as="geometry" />
        </mxCell>
        <mxCell id="n_act" value="act — System 1 «с руками»&#10;1 намерение, 1–2 тула&#10;(браузер / устройство / поиск)&#10;не вышло → эскалация в deliberate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="770" width="270" height="86" as="geometry" />
        </mxCell>
        <mxCell id="n_delib" value="deliberate / heavy&#10;многошаговый план&#10;(heavy = + ревью-петля)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="778" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- deliberate sub-flow (right column) -->
        <mxCell id="n_clar" value="clarify_gate — батч уточнений&#10;Q/A с вариантами (мультиселект), дедуп по нормализации&#10;ответы уходят в контекст плана (не переспрашивает)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="890" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n_decomp" value="decompose → skill_injection&#10;разбивка на пункты + впрыск релевантных навыков&#10;амортизация: есть паттерн → шаги без LLM (дешевле и стабильнее)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="1000" width="320" height="84" as="geometry" />
        </mxCell>
        <mxCell id="n_step" value="step_executor ⟲ — цикл по пунктам&#10;исполнение + покритериальная валидация&#10;валидатор видит РЕАЛЬНО вызванные тулы (анти-галлюцинация)&#10;консенсус-судьи (опц.) · ретрай при провале пункта" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="1114" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n_synth" value="synthesize → validation&#10;сборка ответа со ссылками / грундингом&#10;heavy: review ⟲ (deep-модель крутит ревью до порога)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="1240" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- reflect + end -->
        <mxCell id="n_reflect" value="reflect — запись эпизода + harvest сигнала&#10;компиляция ПАТТЕРНА (паттерн → привычка → навык) · извлечение фактов (+ рёбра графа)&#10;implicit feedback из journal · триггер backward-самообучения при деградации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="1380" width="500" height="92" as="geometry" />
