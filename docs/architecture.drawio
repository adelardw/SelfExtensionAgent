          <mxGeometry x="280" y="490" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_refl" value="reflexion — маршрутизация УРОВНЯ-1: ВЫБОР режима мышления&#10;ReflexionDecision (LLM) + априорная оценка бандита (Beta/Thompson, видит неудачи) + similarity few-shots&#10;высокая неоднозначность → clarify · heavy НЕ предсказывается — ЗАРАБАТЫВАЕТСЯ рантайм-evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="558" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- режимы -->
        <mxCell id="n_fast" value="fast / reason&#10;System 1 / System 2&#10;без инструментов&#10;(reason → validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="672" width="180" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n_act" value="act — System 1 с руками&#10;ОДНО прямое действие, 1–2 инструмента&#10;(BM25-подбор навыка, HITL сохранён)&#10;0 инструментов / ESCALATE →" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
