        <!-- legend -->
        <mxCell id="legend" value="Легенда — цвета: синий = интерфейсы/модели · зелёный = ноды графа · оранжевый = маршрутизация/уточнения · фиолетовый = память · жёлтый = самообучение · красный = безопасность · серый = навыки/способности/БЗ&#10;линии: сплошная стрелка = поток графа · пунктир красный = эскалация · пунктир цветной = нода использует подсистему" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacingLeft=8;" vertex="1" parent="1">
