        </mxCell>

        <mxCell id="n_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_recall" value="recall — память + AutoRAG&#10;эпизоды/факты/выводы/цели + external ctx + БЗ/вложения (BM25 + sanitize)&#10;УСЛОВНЫЙ и ГИБКИЙ (recall_gate): И факты, И ассоциативная память ПО РЕЛЕВАНТНОСТИ&#10;GraphRAG-lite boost · запрос эмбеддится ОДИН раз → переиспользуется в gate/graph И intent-роутере" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="395" width="300" height="66" as="geometry" />
        </mxCell>
