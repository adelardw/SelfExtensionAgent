          <mxGeometry x="830" y="2400" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="skill_selector" value="skill_selector&#10;BM25-подбор релевантных навыков под запрос.&#10;АМОРТИЗАЦИЯ: при ПАТТЕРНЕ — БЕЗ LLM-вызова" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="2690" width="380" height="140" as="geometry" />
