        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;" edge="1" parent="1" source="n_delib" target="n_clar"><mxGeometry relative="1" as="geometry" /></mxCell>
