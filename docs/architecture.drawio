        <!-- ===== FORWARD-ГРАФ LANGGRAPH ===== -->
        <mxCell id="graphbox" value="FORWARD-граф LangGraph (один запрос)   —   backward (self-learning) = credit-assignment по трейсу, пишет только артефакты ParamStore (архитектура графа никогда не меняется)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1">
