        </mxCell>
        <mxCell id="n_delib" value="deliberate / heavy&#10;инструменты + декомпозиция + по-пунктовое исполнение/валидация&#10;heavy добавляет сквозной ревью deep-моделью" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="672" width="300" height="66" as="geometry" />
        </mxCell>

        <!-- под-поток deliberate -->
        <mxCell id="n_clar" value="clarify_gate — батч уточнений (маркеры/открытые)&#10;Q/A мультиселект; ответы → реестр уточнений прогона (дедуп, переиспользуют все ноды)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="772" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_decomp" value="skill_selector → decompose → skill_injection&#10;АМОРТИЗАЦИЯ: при ПАТТЕРНЕ селектор БЕЗ LLM-вызова;&#10;sim≥0.7 → decompose БЕЗ LLM (план прямо из паттерна)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="844" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n_step" value="step_executor ⟲ — исполнение + валидация ПО ПУНКТАМ&#10;валидатор видит РЕАЛЬНО вызванные инструменты (текст ≠ действие)&#10;маскинг контекста внутри шага · догон ask_user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
