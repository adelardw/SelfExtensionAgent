        <!-- ===== СКВОЗНЫЕ ПОДСИСТЕМЫ (правая колонка) ===== -->
        <mxCell id="sub_mem" value="ПАМЯТЬ  (memory/store.py · embedder · vector_index TurboVec · feedback)&#10;эпизоды / факты(+тэги) / выводы / цели / саммари + типизированные граф-рёбра&#10;GraphRAG-lite: densify fact↔fact (cosine) + spreading-activation (per-user, PII-контейнмент)&#10;Память-как-TOOL (3 яруса): search_memory · recall_history · note_to_self" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="380" height="94" as="geometry" />
        </mxCell>
        <mxCell id="sub_router" value="INTENT-РОУТЕР — УРОВЕНЬ-2  (intent.py · eval/route_eval.py)&#10;embedding-kNN кодбук на qvec, ЛЮБОЙ язык (регулярные выражения маршрутизации УДАЛЕНЫ)&#10;сигналы = ГЕЙТЫ поведения: web_grounding (→ пол act) · physical_browser · play_media&#10;media_control · self_contained · растёт из фидбека · route_eval 570 кейсов = 89.3%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="178" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_skills" value="НАВЫКИ  (skills/* · registry.json · retrieval.py)&#10;ToolSearch (BM25S) при росте библиотеки · browser_control: снимок DOM, клик/ввод по №&#10;device/app/ax/phone · web_search (trafilatura→BM25S→vector-rerank, не вся страница)&#10;импорт внешних: карантин → AST-гейт → smoke-песочница → registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="296" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="sub_kb" value="БАЗА ЗНАНИЙ  (knowledge_base.py · lightrag_engine.py)&#10;ГЛОБАЛЬНАЯ: настоящий LightRAG-граф (сущности+связи, multi-hop) · BM25 fallback (без ключа)&#10;СЕССИОННЫЕ вложения (tmp) · AutoRAG в recall (дешёвый BM25 + sanitize, провенанс «свои данные»)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="406" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="sub_cap" value="ИНСТРУМЕНТЫ-СПОСОБНОСТИ  (research.py · compute.py · media.py · mcp_client.py)&#10;research: план под-вопросов → поиск → ВЕРИФИКАЦИЯ факта → синтез&#10;python_exec (песочница) · vision-фигуры PDF · MCP discover/connect/use (живой remote)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="504" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="sub_learn" value="САМООБУЧЕНИЕ / АМОРТИЗАЦИЯ  (improve/ · habits.py · bandit.py · collective.py)&#10;forward: few-shots (глобальные + ПЕР-ЮЗЕР) · backward: дифф-blame → градиенты → опт. промптов&#10;(измеримо ДО/ПОСЛЕ, accept/revert) · per-user backward · паттерны → привычки → навыки&#10;коллективный ярус (best-practices похожим юзерам) · априорная оценка режима (бандит)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
