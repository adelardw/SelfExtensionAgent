        <!-- ===== CROSS-CUTTING SUBSYSTEMS (right column) ===== -->
        <mxCell id="sub_mem" value="ПАМЯТЬ · memory/store.py&#10;типы: эпизоды / факты / выводы / цели + рёбра графа&#10;ГИБКИЙ recall по релевантности (фикс лика контекста между задачами)&#10;TurboVec-ANN (семантика) · importance не разделяет → решает релевантность&#10;journal → implicit feedback для backward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="70" width="430" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_router" value="INTENT-РОУТЕР · intent.py&#10;embedding-kNN кодбук интентов: web_grounding / physical /&#10;play / media_control / self_contained · любой язык (мультиязычно)&#10;few-shots pos/neg · онлайн-рост из фидбека&#10;creation-seed → self_contained (анти-hijack веб-поиска)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="190" width="430" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_skills" value="НАВЫКИ · skills/* + registry.json&#10;ToolSearch (BM25S) поверх каталога тулов&#10;browser_control (DOM-снапшот, клик по №) · device/app/ax/phone&#10;web_search · skill_creation (агент пишет себе навык)&#10;ИМПОРТ внешних: карантин(анти-zip-slip)→AST-гейт→smoke-песочница→registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="310" width="430" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_kb" value="БАЗА ЗНАНИЙ · knowledge_base.py&#10;LightRAG-граф: сущности + связи, multi-hop обход&#10;BM25-фолбэк (граф за тулом) · AutoRAG-впрыск в recall&#10;сессионные вложения файлов (tmp, own_docs-флаг)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sub_cap" value="СПОСОБНОСТИ-ТУЛЫ&#10;research: план → поиск (SearXNG / cloakbrowser) → верификация → синтез&#10;python_exec (песочница rlimits) · vision-разбор PDF&#10;MCP: discover в реестре → approve → connect (uvx / npx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="536" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sub_learn" value="САМООБУЧЕНИЕ / АМОРТИЗАЦИЯ&#10;forward: few-shots (глобальные + пер-юзер)&#10;backward: дифф-вина по трейсу → «градиенты» → оптимизация промптов&#10;измеримо ДО/ПОСЛЕ · ParamStore (НЕ трогает код графа)&#10;лестница паттерн→привычка→навык · коллективный ярус · бандит-выбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="642" width="430" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_sec" value="БЕЗОПАСНОСТЬ&#10;AST-гейт + smoke в песочнице (rlimits / syscall-sandbox)&#10;HITL deny-by-default на действия · анти-injection в выводах тулов&#10;анти-PII пол recall · запрет обучения на эксплойтах/взломе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="762" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sub_models" value="МОДЕЛИ · config.yml (OpenRouter | Ollama локально)&#10;роли: fast=роутинг/валидация · code=исполнение · deep=heavy-ревью&#10;тезис: дешёвый тир + харнесс, НЕ размер модели&#10;провайдер / ключ / base_url в GUI или config.local.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="868" width="430" height="90" as="geometry" />
        </mxCell>

