        </mxCell>
        <mxCell id="step_executor" value="step_executor&#10;исполнение + валидация ПО ПУНКТАМ (⟲ ретрай / шаг).&#10;валидатор видит РЕАЛЬНО вызванные тулы&#10;(текст ≠ действие) · маскинг контекста внутри шага ·&#10;догон ask_user на развилке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="3850" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="synthesize" value="synthesize&#10;сборка финального решения из шагов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="4140" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="review" value="review&#10;только HEAVY: сквозной ревью собранного решения&#10;DEEP-моделью · проблемы → fix-подшаги&#10;(→ step_executor) · чисто → validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
