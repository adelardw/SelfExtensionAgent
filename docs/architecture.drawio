        <mxCell id="recall" value="recall&#10;память (эпизоды / факты / выводы / цели)&#10;+ implicit feedback + external ctx + AutoRAG&#10;(БЗ юзера + файлы сессии, BM25 + sanitize).&#10;УСЛОВНЫЙ и ГИБКИЙ (recall_gate): И факты, И&#10;ассоциативная память ПО РЕЛЕВАНТНОСТИ · GraphRAG-lite&#10;запрос эмбеддится ОДИН раз → роутер переиспользует" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="660" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reflexion" value="reflexion&#10;Self-Reflexion ВЫБОР режима мышления по анализу&#10;задачи · + априор бандита (Beta/Thompson по эпизодам&#10;юзера, видит неудачи) + few-shots&#10;+ intent-роутер L2 (embedding-kNN, любой язык).&#10;высокая неоднозначность → clarify · heavy НЕ&#10;предсказывается — ЗАРАБАТЫВАЕТСЯ рантайм-evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="950" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="act" value="act&#10;System 1 с руками: ОДНО прямое действие&#10;1–2 инструментами (BM25-подбор навыка, HITL).&#10;ноль вызовов / ESCALATE → goal (путь deliberate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="goal&#10;целеполагание: цель + «стоящая» цель +&#10;rubric, держится в контексте всех нод" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fast_answer" value="fast_answer&#10;прямой ответ (System 1 / System 2), без тулов;&#10;ветка clarify тоже отвечает здесь" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="clarify_gate" value="clarify_gate&#10;батч точных уточнений (маркеры где набор конечен,&#10;открытые где нет). ответы → реестр уточнений&#10;прогона (дедуп, переиспользуют&#10;decompose / step / synthesize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="1530" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reason" value="reason&#10;System 2: глубокое пошаговое рассуждение,&#10;без тулов → проходит финальную validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1530" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="router" value="router&#10;ветка пути deliberate: создать навык&#10;(create_skills) или взять готовые (skill_selector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1820" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="create_skills" value="create_skills&#10;ReAct строит новый навык (код) под пробел&#10;в способностях → в библиотеку навыков" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
