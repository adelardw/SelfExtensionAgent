<mxfile host="app.diagrams.net" agent="self-extension-agent">
  <diagram name="self-extension-agent" id="selfext-arch-en">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="self-extension-agent — architecture · the LangGraph graph is a TRAINABLE PROGRAM (a run = forward pass, self-learning = backward over the trace) · a cheap model + harness, not model size" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1220" height="30" as="geometry" />
        </mxCell>

        <!-- ===== INTERFACES ===== -->
        <mxCell id="clients" value="Interfaces — thin clients (shared graph + shared memory)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="780" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_gui" value="Web / Desktop GUI&#10;React+Vite+Tailwind · desktop.py&#10;live progress · clarify card · mic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_repl" value="REPL&#10;main.py&#10;/kb /attach /model …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="105" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_tg" value="Telegram&#10;bot.py&#10;photos / docs / voice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="105" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_ext" value="Chrome extension&#10;agent in your browser&#10;(+ extension token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="105" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== SERVER ===== -->
        <mxCell id="server" value="FastAPI server (server.py) — background run (astream) · /chat · /run/{id} poll · /run/{id}/respond · /settings · /upload · /transcribe&#10;interactive clarify (Q/A multiselect) + HITL confirm · live per-node progress · thin client ↔ Python brain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="780" height="66" as="geometry" />
        </mxCell>

        <!-- ===== LANGGRAPH FORWARD GRAPH ===== -->
        <mxCell id="graphbox" value="LangGraph FORWARD graph (one request)   —   backward (self-learning) = credit-assignment over the trace, writes only ParamStore artifacts (the graph architecture never changes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="800" height="1040" as="geometry" />
        </mxCell>

        <mxCell id="n_start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_recall" value="recall — memory + AutoRAG&#10;episodes/facts/conclusions/goals + external ctx + KB/attachments (BM25 + sanitize)&#10;CONDITIONAL &amp; FLEXIBLE (recall_gate): BOTH facts AND associative memory BY RELEVANCE&#10;GraphRAG-lite boost · the query is embedded ONCE → reused by gate/graph AND the intent router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="395" width="300" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n_goal" value="goal — aim + a worthwhile goal + rubric (kept in context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="490" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_refl" value="reflexion — LEVEL-1 routing: CHOICE of thinking mode&#10;ReflexionDecision (LLM) + bandit prior (Beta/Thompson, sees failures) + similarity few-shots&#10;high ambiguity → clarify · heavy is NOT predicted — it is EARNED by runtime evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="558" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- modes row -->
        <mxCell id="n_fast" value="fast / reason&#10;System 1 / System 2&#10;no tools&#10;(reason → validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="672" width="180" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n_act" value="act — System 1 with hands&#10;ONE direct action, 1–2 tools&#10;(BM25 skill pick, HITL kept)&#10;0 tools / ESCALATE →" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="672" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n_delib" value="deliberate / heavy&#10;tools + decomposition + per-item execute/validate&#10;heavy adds an end-to-end review by the deep model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="672" width="300" height="66" as="geometry" />
        </mxCell>

        <!-- deliberate sub-flow -->
        <mxCell id="n_clar" value="clarify_gate — batched clarifications (markers/open)&#10;Q/A multiselect; answers → the run's clarification registry (dedup, reused by all nodes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="772" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_decomp" value="skill_selector → decompose → skill_injection&#10;AMORTIZATION: with a PATTERN the selector runs with NO LLM;&#10;sim≥0.7 → decompose with NO LLM (plan straight from the pattern)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="844" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n_step" value="step_executor ⟲ — execute + validate PER ITEM&#10;validator sees the ACTUALLY-called tools (text ≠ action)&#10;within-step context masking · ask_user catch-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="924" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n_synth" value="synthesize — assemble the solution from the steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="1004" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_review" value="review ⟲ (heavy only)&#10;end-to-end by the deep model&#10;problems → fix sub-steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="1004" width="180" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n_val" value="validation — grounding + rubric check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="540" y="1076" width="280" height="44" as="geometry" />
        </mxCell>

        <mxCell id="n_reflect" value="reflect — write the episode (+ interaction journal), harvest signal (HITL/clarify → profile facts),&#10;compile the PATTERN (+ win/lose) → promote to the collective pool, detect a habit,&#10;extract facts (+tags, edges) · summary · prune · degradation tracking · auto self-learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="1180" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_end" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="1280" width="130" height="40" as="geometry" />
        </mxCell>

        <!-- ===== graph control-flow edges (solid) ===== -->
        <mxCell id="e_srv" style="html=1;endArrow=block;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="server" target="n_start"><mxGeometry relative="1" as="geometry" /></mxCell>
