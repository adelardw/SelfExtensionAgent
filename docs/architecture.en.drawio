        <!-- ===== CROSS-CUTTING SUBSYSTEMS (right column) ===== -->
        <mxCell id="sub_mem" value="MEMORY  (memory/store.py · embedder · vector_index TurboVec · feedback)&#10;episodes / facts(+tags) / conclusions / goals / summaries + typed graph edges&#10;GraphRAG-lite: densify fact↔fact (cosine) + spreading-activation (per-user, PII containment)&#10;Memory-as-TOOL (3 tiers): search_memory · recall_history · note_to_self" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="380" height="94" as="geometry" />
        </mxCell>
        <mxCell id="sub_router" value="INTENT ROUTER — LEVEL-2  (intent.py · eval/route_eval.py)&#10;embedding-kNN codebook on qvec, ANY language (routing regexes REMOVED)&#10;signals = behavior GATES: web_grounding (→ act floor) · physical_browser · play_media&#10;media_control · self_contained · grows from feedback · route_eval 570 cases = 89.3%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="178" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_skills" value="SKILLS  (skills/* · registry.json · retrieval.py)&#10;ToolSearch (BM25S) as the library grows · browser_control: DOM snapshot, click/type by #&#10;device/app/ax/phone · web_search (trafilatura→BM25S→vector-rerank, never the full page)&#10;import external: quarantine → AST gate → smoke-sandbox → registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="296" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="sub_kb" value="KNOWLEDGE BASE  (knowledge_base.py · lightrag_engine.py)&#10;GLOBAL: real LightRAG graph (entities+relations, multi-hop) · BM25 fallback (no key)&#10;SESSION attachments (tmp) · AutoRAG in recall (cheap BM25 + sanitize, own-data provenance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="406" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="sub_cap" value="CAPABILITY TOOLS  (research.py · compute.py · media.py · mcp_client.py)&#10;research: sub-question plan → search → fact VERIFICATION → synthesize&#10;python_exec (sandbox) · vision PDF figures · MCP discover/connect/use (live remote)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="504" width="380" height="84" as="geometry" />
        </mxCell>
        <mxCell id="sub_learn" value="SELF-LEARNING / AMORTIZATION  (improve/ · habits.py · bandit.py · collective.py)&#10;forward: few-shots (global + PER-USER) · backward: diff-blame → gradients → prompt opt&#10;(measured BEFORE/AFTER, accept/revert) · per-user backward · patterns → habits → skills&#10;collective tier (best-practices to similar users) · mode bandit prior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="602" width="380" height="104" as="geometry" />
        </mxCell>
        <mxCell id="sub_sec" value="SECURITY  (utils_validation.py · utils.py · hitl.py · improve/safety.py)&#10;AST gate on code writes · smoke in a process sandbox (rlimits/kill) · HITL deny-by-default&#10;anti-injection in tool/MCP/search/AutoRAG outputs · anti-PII floor · no learning from exploits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="720" width="380" height="92" as="geometry" />
        </mxCell>
        <mxCell id="sub_models" value="MODELS  (config.yml · OpenRouter | Ollama)&#10;fast = routing/validation/extraction · code = step execution · deep = heavy review ONLY&#10;cheap tier + harness, not model size  (a typical fast query ≈ $0.001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="826" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sub_trace" value="TRACING / DIAGNOSTICS (tracing/) — spans per node (traces.db) · self-diagnosis · rotation   ·   MAINTENANCE: safe dependency auto-update (health-check + rollback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="920" width="380" height="56" as="geometry" />
        </mxCell>

