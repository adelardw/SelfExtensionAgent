        </mxCell>
        <mxCell id="recall" value="recall&#10;memory (episodes / facts / conclusions / goals)&#10;+ implicit feedback + external ctx + AutoRAG&#10;(user KB + session files, BM25 + sanitize).&#10;CONDITIONAL &amp; FLEXIBLE (recall_gate): facts AND&#10;associative memory BY RELEVANCE · GraphRAG-lite ·&#10;query embedded ONCE → router reuses it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="660" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reflexion" value="reflexion&#10;Self-Reflexion CHOICE of the thinking mode from&#10;task analysis · + bandit prior (Beta/Thompson over&#10;the user&#x27;s episodes, sees failures) + few-shots&#10;+ intent router L2 (embedding-kNN, any language).&#10;high ambiguity → clarify · heavy is NOT predicted —&#10;it is EARNED by runtime evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="950" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="act" value="act&#10;System 1 with hands: ONE direct action with&#10;1–2 tools (BM25 skill pick, HITL kept).&#10;zero tool calls / ESCALATE → goal (deliberate path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1370" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="goal" value="goal&#10;goal-setting: aim + a &#x27;worthwhile&#x27; goal +&#10;rubric, kept in context for all nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fast_answer" value="fast_answer&#10;direct answer (System 1 / System 2), no tools;&#10;the clarify branch also resolves here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1240" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="clarify_gate" value="clarify_gate&#10;batch of precise clarifications (markers where the&#10;set is finite, open otherwise). answers → the run&#x27;s&#10;clarification registry (dedup, reused by&#10;decompose / step / synthesize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="1530" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reason" value="reason&#10;System 2: deep step-by-step reasoning,&#10;no tools → goes through final validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1530" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="router" value="router&#10;route the deliberate path: build a new skill&#10;(create_skills) or pick existing ones (skill_selector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1820" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="create_skills" value="create_skills&#10;ReAct builds a new skill (code) for a&#10;capability gap → into the skill library" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="2110" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sgr_create" value="sgr_create&#10;SGR review + smoke test of the new skill →&#10;load it (L1 self-improvement) or back to router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="2400" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="skill_selector" value="skill_selector&#10;BM25 retrieval of relevant skills for the query.&#10;AMORTIZATION: with a PATTERN runs with NO LLM call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="2690" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="capability_research" value="capability_research&#10;research capabilities; on a gap discover &amp; connect&#10;an MCP server (registry + trusted catalog, HITL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="2980" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="decompose" value="decompose&#10;plan the task into steps → skill_injection.&#10;at sim ≥ 0.7 → NO LLM (plan straight from a pattern)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="3270" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="skill_injection" value="skill_injection&#10;inject the selected skills / tools into&#10;the step executor&#x27;s toolset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="3560" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step_executor" value="step_executor&#10;execute + validate PER ITEM (⟲ retry / next step).&#10;the validator sees the ACTUALLY-called tools&#10;(text ≠ action) · within-step context masking ·&#10;ask_user catch-up at a fork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;shadow=1;arcSize=10;" vertex="1" parent="1">
