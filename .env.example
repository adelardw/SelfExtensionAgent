OPEN_ROUTER_API_KEY=          # обязателен при provider: openrouter (LLM и эмбеддинги)
# OPENROUTER_BASE_URL=        # опц. — свой OpenAI-совместимый шлюз/прокси (дефолт: https://openrouter.ai/api/v1)
# OLLAMA_BASE_URL=            # опц. — удалённый Ollama (дефолт: http://localhost:11434/v1); /v1 допишется сам
SEARXNG_URL=http://localhost:8080   # опц. — приватный свежий поиск
TELEGRAM_BOT_TOKEN=           # опц. — для Telegram-бота (bot.py)
# OPENAI_API_KEY=             # опц. — альтернатива OpenRouter для эмбеддингов

# Single-owner API. Generate a random token locally; never put it in prompts or URLs.
# AGENT_API_TOKEN=           # 32+ random characters; Bearer API or browser Basic user "sea"
# AGENT_BIND_HOST=127.0.0.1  # remote bind refuses to start without a strong API token
# AGENT_ALLOWED_HOSTS=      # comma-separated exact additional HTTP Host names, no ports
# AGENT_TLS_CERT=           # remote requests require TLS at the server (no forwarded-header trust)
# AGENT_TLS_KEY=
# AGENT_WEB_ALLOWED_HOSTS=docs.python.org,github.com,raw.githubusercontent.com
# Exact allowlist for browse/read_url/fetch_data. Unset = public HTTP allowed; not universal DLP.
# Does not constrain cloud providers, fixed search services, MCP or device/browser tools.
